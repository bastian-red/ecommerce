{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @shop/db generate && pnpm --filter @shop/shared --filter @shop/db --filter @shop/payments --filter @shop/storage --filter @shop/notifications build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "../../packages/db/generated/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
