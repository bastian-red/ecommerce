{
  "$schema": "https://turbo.build/schema.json",

  // Turbo 2 defaults to strict env mode: a task's child process sees only the
  // names below plus turbo's own system allowlist. Everything else is stripped
  // silently, which is how this repo once started an API with no AUTH_SECRET and
  // surfaced it four layers down as ECONNREFUSED. The default is kept
  // deliberately -- switching to "loose" would hide the next under-declaration
  // instead of fixing this one. scripts/env-contract.mjs keeps these lists
  // honest against .env.example and against what the source actually reads.

  // Feeds the cache key. Only variables that change what gets BUILT belong here,
  // and never a secret: turbo hashes the value, so a rotated SMTP password would
  // invalidate every cached build and put the credential into the hash input.
  "globalEnv": [
    "API_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NODE_ENV",
    "PAYMENTS_DRIVER",
    "STORAGE_DRIVER"
  ],

  // Reaches the process without entering the cache key: runtime wiring, ports,
  // credentials, operational tuning. Changing one of these must not force a
  // rebuild, but the process must still see it.
  "globalPassThroughEnv": [
    "API_PORT",
    "APP_BASE_URL",
    "APP_VERSION",
    "AUTH_SECRET",
    "AUTH_URL",
    "CURRENCY",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "FREE_SHIPPING_THRESHOLD_CENTS",
    "MAIL_FROM",
    "MOCK_WEBHOOK_SECRET",
    "PORT",
    "RATE_LIMIT_AUTH",
    "RATE_LIMIT_CHECKOUT",
    "RATE_LIMIT_GLOBAL",
    "REDIS_URL",
    "RESERVATION_TTL_MINUTES",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SHIPPING_FLAT_CENTS",
    "SMTP_HOST",
    "SMTP_PASSWORD",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "STORAGE_LOCAL_DIR",
    "STORAGE_PUBLIC_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "TAX_BASIS_POINTS",
    "WEB_PORT"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // `^build` even though every dev server watches its own sources: the API, the
    // worker and the web app import the workspace packages through their
    // package.json `main`, which points at `dist/`. On a machine that has built
    // once that file is there and `pnpm dev` works; on a fresh clone the first
    // import dies and the only symptom is that nothing ever listens on :4000.
    // scripts/dev-smoke.sh reported exactly that in CI, as a timeout.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },

    // The seed imports workspace packages whose package.json points at
    // `dist/index.js`. On a clean checkout that file does not exist, and the
    // failure is `Cannot find module .../dist/index.js` from inside the seed: an
    // error about module resolution, several layers from "the workspace is not
    // built". `dependsOn: ["^build"]` makes `pnpm db:seed` build what it needs
    // first, for CI and for a reader following the README alike.
    //
    // Never cached: seeding and migrating write to a database turbo cannot see,
    // so a cache hit would skip the write and report success.
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    }
  }
}
