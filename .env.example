# Copy to .env and fill in. Never commit .env — it is gitignored and the
# pre-commit hook runs gitleaks over staged changes.

# --- Core ---
NODE_ENV=development

# --- Database (Postgres) ---
# The local docker-compose Postgres is published on 5433 to avoid clashing with a
# host PostgreSQL on the default 5432.
DATABASE_URL=postgresql://shop:shop@localhost:5433/shop?schema=public

# --- Redis ---
# Carts, rate limiting, BullMQ queues and the worker heartbeat.
REDIS_URL=redis://localhost:6380

# --- API service ---
API_PORT=4000
# Server-to-server base URL (private network in production).
API_BASE_URL=http://localhost:4000

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible API URL. Baked at build time by infra/Dockerfile.web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth ---
# Shared by web (Auth.js session + service-token minting) and api (token
# verification). Must be >= 16 chars. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Payments ---
# stripe | mock. The mock driver hosts its own signed checkout so the full
# webhook path runs with no Stripe account and no tunnel; CI and E2E use it.
PAYMENTS_DRIVER=mock
# Signing secret for the mock driver's webhooks (>= 16 chars).
MOCK_WEBHOOK_SECRET=mock-webhook-secret-at-least-32-chars
# Stripe test-mode credentials. Only needed when PAYMENTS_DRIVER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# --- Storage (product images) ---
# local | s3
STORAGE_DRIVER=local
# Where the local driver writes files. Mount a volume here in production.
STORAGE_LOCAL_DIR=./var/uploads
# Public base URL images are served from (the API's /media route by default).
STORAGE_PUBLIC_URL=http://localhost:4000/media
# S3 / R2 / Cloudinary-compatible. Only needed when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
# Local dev uses Mailhog (docker-compose). Leave SMTP_HOST empty to fall back to
# the log channel, which never throws.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=orders@shop.local

# --- Inventory / order lifecycle ---
# How long a checkout holds stock before the worker releases the reservation.
RESERVATION_TTL_MINUTES=15
# How often the worker sweeps for expired reservations.
SWEEP_INTERVAL_SECONDS=30
# Tax applied at checkout, in basis points (875 = 8.75%).
TAX_BASIS_POINTS=875
# Free shipping at or above this subtotal, in minor units (cents).
FREE_SHIPPING_THRESHOLD_CENTS=5000
SHIPPING_FLAT_CENTS=599

# --- Rate limits (requests per minute, per client IP) ---
# The integration suite drives many concurrent checkouts from one address, so it
# raises these; production should leave them at the defaults.
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_CHECKOUT=30
