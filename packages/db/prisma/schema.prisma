// Conventions: snake_case in the database via @map/@@map, cuid ids, every
// instant is timestamptz, every monetary amount is an integer in minor units
// (cents). No floats anywhere near money.

generator client {
  provider = "prisma-client-js"
  // Generated into the package rather than into node_modules/.prisma.
  //
  // The default location lives inside pnpm's content-addressed store, which
  // means a production install in a Docker image (or `pnpm deploy --prod`)
  // rebuilds node_modules and silently drops the generated client. Emitting it
  // here makes it an ordinary file in the package that gets copied like any
  // other build output.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  EXPIRED
}

enum StockMovementKind {
  RESERVE
  RELEASE
  FULFILL
  RESTOCK
  ADJUST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @default("")
  status      ProductStatus @default(ACTIVE)
  categoryId  String?       @map("category_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  variants ProductVariant[]

  // Full-text search is served by a GIN expression index created in the
  // _stock_invariants migration; see CatalogService.search.
  @@index([status])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  storageKey String   @map("storage_key")
  alt        String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// NOTE: stockOnHand / stockReserved are protected by the CHECK constraint
/// `variant_stock_non_negative` (packages/db/prisma/migrations/*_stock_invariants).
/// Available stock is always `stockOnHand - stockReserved`. Never mutate these
/// with a read-modify-write; use InventoryService's conditional UPDATEs.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sku           String   @unique
  name          String
  priceCents    Int      @map("price_cents")
  stockOnHand   Int      @default(0) @map("stock_on_hand")
  stockReserved Int      @default(0) @map("stock_reserved")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  ledger     StockLedger[]

  @@index([productId, position])
  @@map("product_variants")
}

model Order {
  id     String      @id @default(cuid())
  number String      @unique
  userId String?     @map("user_id")
  email  String
  status OrderStatus @default(PENDING)

  currency      String @default("usd")
  subtotalCents Int    @map("subtotal_cents")
  taxCents      Int    @map("tax_cents")
  shippingCents Int    @map("shipping_cents")
  totalCents    Int    @map("total_cents")

  /// While PENDING the order holds a stock reservation until this instant. The
  /// worker sweeps past-due PENDING orders and releases them.
  reservationExpiresAt DateTime? @map("reservation_expires_at") @db.Timestamptz(6)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  fulfilledAt          DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)

  shippingName       String @map("shipping_name")
  shippingLine1      String @map("shipping_line1")
  shippingCity       String @map("shipping_city")
  shippingPostalCode String @map("shipping_postal_code")
  shippingCountry    String @map("shipping_country")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  ledger   StockLedger[]

  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([email])
  @@map("orders")
}

/// Product title, variant name, SKU and unit price are snapshotted so an order
/// stays readable after the catalog changes underneath it.
model OrderItem {
  id             String @id @default(cuid())
  orderId        String @map("order_id")
  variantId      String @map("variant_id")
  productTitle   String @map("product_title")
  variantName    String @map("variant_name")
  sku            String
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int    @map("line_total_cents")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // One line per variant keeps the reservation and release maths trivially
  // symmetric: release exactly what the line reserved.
  @@unique([orderId, variantId])
  @@map("order_items")
}

/// Append-only. Signed deltas, so SUM(on_hand_delta) over a variant's ledger
/// reconstructs its stock from zero — that is what the concurrency test asserts.
model StockLedger {
  id            String            @id @default(cuid())
  variantId     String            @map("variant_id")
  orderId       String?           @map("order_id")
  kind          StockMovementKind
  onHandDelta   Int               @map("on_hand_delta")
  reservedDelta Int               @map("reserved_delta")
  reason        String            @default("")
  actorId       String?           @map("actor_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_ledger")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  provider        String
  /// Provider checkout session id. Unique so a replayed session cannot produce
  /// a second payment row. A retried checkout creates a new session, hence a new
  /// row — but only one of them can ever reach SUCCEEDED (partial unique index
  /// `payments_one_succeeded_per_order`).
  sessionId       String        @unique @map("session_id")
  paymentIntentId String?       @map("payment_intent_id")
  status          PaymentStatus @default(PENDING)
  amountCents     Int           @map("amount_cents")
  currency        String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

/// Webhook de-duplication. The composite primary key IS the idempotency
/// guarantee: ingest is INSERT ... ON CONFLICT DO NOTHING, so a duplicate
/// delivery inserts zero rows and is acknowledged without re-processing. An
/// application-level "does it exist?" check would race; a primary key cannot.
model WebhookEvent {
  provider   String
  eventId    String    @map("event_id")
  type       String
  payload    Json
  orderId    String?   @map("order_id")
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error      String?

  @@id([provider, eventId])
  @@index([type, receivedAt])
  @@map("webhook_events")
}
